# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/milletverse

# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# Admin Configuration (Initial Setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# CORS Whitelist (Comma separated URLs)
# For production: https://milletverse.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://milletverse.vercel.app

# External Services
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=google/gemini-2.5-flash
