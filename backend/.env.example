# Server Config
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=your_mongodb_connection_string

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Client Config
CLIENT_URL=http://localhost:5173

# Generative AI (OpenRouter) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: override model (default: google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional: cap output tokens (default 4096; lower if you have limited credits)
# OPENROUTER_MAX_TOKENS=4096

# Cloudinary (Optional, if using for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (For transactional notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_phone_number

